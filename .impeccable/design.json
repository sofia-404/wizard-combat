  "narrative": {
    "northStar": "Arc & Anchor",
    "overview": "Wizard Combat uses the precision of movement notation inside a quiet, mature dark-fantasy world. The anchor marks intent, the trace records movement, and the terminal diamond marks completion. These shapes teach the same action that drives the game.\n\nNavy and teal hold the scene. Aged gold organizes it. Cyan appears when magic or input becomes active. Cormorant Garamond gives titles an engraved character; Source Sans 3 keeps instructions direct. See DESIGN.md for screen-specific design limits and AGENTS.md for work scope.",
    "keyCharacteristics": [
      "Deliberate strokes and open space.",
      "Warm metal against a cool, dark field.",
      "Clear instruction beside expressive titles.",
      "One active gesture at a time."
    ],
    "rules": [
      {
        "name": "Signal",
        "body": "Reserve cyan for active input, focus, and magic. A static instructional start point may use cyan to identify where active input begins. Do not fill every panel with glow.",
        "section": "colors"
      },
      {
        "name": "Contrast",
        "body": "Use text, muted, gold, cyan, danger, and success on the dark surfaces. Filled gold controls use ink text. Do not assume a decorative line color is suitable for a control boundary; use gold or muted for an essential boundary. Status always has text or shape as well as color.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do keep active input easy to see against the scene.",
      "Do use readable sans-serif instructions and serif titles.",
      "Do preserve current spell directions and three-cast lesson behavior.",
      "Do show errors with a specific next action.",
      "Do label simulated previews and unimplemented features."
    ],
    "donts": [
      "For new original-scene concepts, avoid third-party crests, faction symbols, castle silhouettes, typography, maps, and interface layouts. Preserve shipped themed assets outside a requested change; see DESIGN.md.",
      "Don't use cartoon characters, toy-like controls, or ornamental clutter.",
      "Don't make cyan decoration compete with the live gesture.",
      "Don't hide tracking loss behind a spell-failure message.",
      "Don't imply that the design preview enables new gameplay."
    ]
  }
}
